# Sincronização das respostas da Consulta Pública LOA 2027 com uma planilha
# do Google Sheets. Esta aplicação não usa banco de dados — a planilha é a
# única fonte de verdade das respostas. Todas as 4 variáveis são obrigatórias.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Respostas
